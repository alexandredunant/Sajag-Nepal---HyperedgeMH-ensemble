# ---------------------------------------------------------------------------
# Data (too large for git; see README.md for the expected layout and sources)
# ---------------------------------------------------------------------------
data/*
# ...except the district-level model outputs (~1 MB) cited in the data availability statement
!data/aggregated_stats/

# Local archive of superseded drafts, scripts, figures and Overleaf comment exports
# (kept on disk only; earlier versions are also in the git history)
_archive/

# Claude Code session files
.claude/

# ---------------------------------------------------------------------------
# Figure-script outputs
# ---------------------------------------------------------------------------
# Only the PNGs are tracked; EPS/PDF copies are large (Fig 1 EPS > 100 MB) and can be regenerated
FIGURES/formats/
FIGURES/revised/
FIGURES/revised_v2/*.eps
FIGURES/revised_v2/*.pdf

# ---------------------------------------------------------------------------
# LaTeX build products
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.spl
*.synctex.gz
*.toc
*.pdf

# Overleaf comment exports (timestamped folders; contain co-authors' emails)
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*Z/

# ---------------------------------------------------------------------------
# Python / OS
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
Thumbs.db
.DS_Store
