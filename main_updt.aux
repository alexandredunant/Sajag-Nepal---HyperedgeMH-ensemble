\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces A, exceedance probability of buildings damaged by earthquake shaking in each of the 77 districts in Nepal across the 30 scenario earthquakes. Each line shows an exceedance curve for a single district. Curves are coloured by physiographic setting of each district. Median impacts for each district across the ensemble are shown by where the curves intersect the 50\% line (dashed horizontal line), while worst-case impacts are shown by the intersection with the x axis. B, exceedance probability of buildings damaged by landslides in each district. C, exceedance probability of road segments damaged by landslides in each district.}}{18}{figure.caption.4}\protected@file@percent }
\newlabel{fig:district_exceedance}{{4}{18}{A, exceedance probability of buildings damaged by earthquake shaking in each of the 77 districts in Nepal across the 30 scenario earthquakes. Each line shows an exceedance curve for a single district. Curves are coloured by physiographic setting of each district. Median impacts for each district across the ensemble are shown by where the curves intersect the 50\% line (dashed horizontal line), while worst-case impacts are shown by the intersection with the x axis. B, exceedance probability of buildings damaged by landslides in each district. C, exceedance probability of road segments damaged by landslides in each district}{figure.caption.4}{}}
